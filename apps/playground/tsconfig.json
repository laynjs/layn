{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@laynjs/adapter-utils": ["../../packages/adapter-utils/src/index.ts"],
      "@laynjs/core": ["../../packages/core/src/index.ts"],
      "@laynjs/dom": ["../../packages/dom/src/index.ts"],
      "@laynjs/react": ["../../packages/react/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
