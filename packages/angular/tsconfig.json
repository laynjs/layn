{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "noImplicitOverride": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "useDefineForClassFields": false,
    "noEmit": true,
    "declaration": false,
    "declarationMap": false,
    "composite": false,
    "paths": {
      "@laynjs/adapter-utils": ["../adapter-utils/src/index.ts"],
      "@laynjs/core": ["../core/src/index.ts"],
      "@laynjs/dom": ["../dom/src/index.ts"]
    }
  },
  "include": ["src"]
}
