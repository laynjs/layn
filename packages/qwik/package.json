{
  "name": "@laynjs/qwik",
  "version": "0.5.0",
  "description": "Headless Qwik adapter for layn: a resumable useLayn hook over the engine and DOM bindings.",
  "keywords": [
    "layout",
    "layout-engine",
    "masonry",
    "grid",
    "grid-layout",
    "waterfall",
    "justified",
    "packing",
    "quilt",
    "virtualization",
    "virtual-scroll",
    "infinite-scroll",
    "headless",
    "ssr",
    "photo-gallery",
    "drag-and-drop",
    "qwik",
    "resumable"
  ],
  "type": "module",
  "license": "MIT",
  "author": "majovkovic <majovkovic@gmail.com>",
  "homepage": "https://layn.io",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/laynjs/layn.git",
    "directory": "packages/qwik"
  },
  "bugs": {
    "url": "https://github.com/laynjs/layn/issues"
  },
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.tsbuildinfo",
    "!dist/**/*.map"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@laynjs/adapter-utils": "workspace:*",
    "@laynjs/core": "workspace:*",
    "@laynjs/dom": "workspace:*"
  },
  "peerDependencies": {
    "@builder.io/qwik": "^1.5.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@builder.io/qwik": "^1.20.0"
  }
}
