{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": true,
    "declaration": true,
    "declarationMap": true,
    "noEmit": false,
    "rootDir": "src",
    "outDir": "dist",
    "tsBuildInfoFile": "dist/.tsbuildinfo",
    "paths": {}
  },
  "references": [
    { "path": "../adapter-utils/tsconfig.build.json" },
    { "path": "../core/tsconfig.build.json" },
    { "path": "../dom/tsconfig.build.json" }
  ],
  "include": ["src"],
  "exclude": ["src/**/*.test.ts", "src/**/*.bench.ts", "src/**/__fixtures__/**"]
}
