---
import { createEngine, masonry } from '@laynjs/core'
import BaseHead from '../components/BaseHead.astro'
import Logo from '../components/Logo.astro'
import { DOCS_URL, HOME_URL, OG_IMAGE, PLAYGROUND_URL, REPO_URL } from '../lib/site'
import '../styles/base.css'
import '../styles/home.css'

const TITLE = 'layn - The headless layout engine for the web'
const DESCRIPTION =
  'Headless, framework-agnostic web layout engine. SSR-deterministic masonry, justified, packing and more, with first-class virtualization.'

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'layn',
  description: DESCRIPTION,
  applicationCategory: 'DeveloperApplication',
  operatingSystem: 'Any',
  url: HOME_URL,
  license: 'https://opensource.org/licenses/MIT',
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'USD' },
  author: { '@type': 'Organization', name: 'layn', url: HOME_URL },
  sameAs: [REPO_URL],
}

const algorithms = [
  { id: 'masonry', name: 'masonry' },
  { id: 'columns', name: 'columns' },
  { id: 'justified', name: 'justified' },
  { id: 'staggered', name: 'staggered' },
  { id: 'packing', name: 'packing' },
  { id: 'binPacking', name: 'bin' },
  { id: 'quilt', name: 'quilt' },
  { id: 'magazine', name: 'magazine' },
  { id: 'horizontalMasonry', name: 'horizontal' },
]

const ratios = [
  0.72, 1.4, 0.92, 1.1, 0.66, 1.5, 0.85, 1.02, 0.75, 1.32, 0.95, 1.2, 0.7, 1.6, 0.88, 1.05, 0.78,
  1.35, 0.9, 1.15, 0.68, 1.45, 0.83, 1.25,
]
const toneOrder = [0, 3, 1, 4, 2, 2, 4, 0, 3, 1, 4, 1, 3, 0, 2, 1, 2, 4, 0, 3, 3, 0, 2, 1]

const REF_WIDTH = 500
const initEngine = createEngine({
  algorithm: masonry({ columns: 3 }),
  items: ratios.map((ar, i) => ({ id: i, aspectRatio: ar })),
  gap: { x: 12, y: 12 },
  viewport: { width: REF_WIDTH, height: 620 },
})
const initSnapshot = initEngine.getSnapshot()
const initSize = initSnapshot.contentSize
const tiles = ratios.map((ar, i) => {
  const rect = initSnapshot.positions.rectAt(i)
  return { ar, tone: toneOrder[i] ?? 0, x: rect.x, y: rect.y, w: rect.width, h: rect.height }
})
---

<html lang="en">
  <head>
    <BaseHead title={TITLE} description={DESCRIPTION} canonical={HOME_URL}>
      <meta property="og:type" content="website" />
      <meta property="og:site_name" content="layn" />
      <meta property="og:title" content={TITLE} />
      <meta property="og:description" content={DESCRIPTION} />
      <meta property="og:url" content={HOME_URL} />
      <meta property="og:image" content={OG_IMAGE} />
      <meta property="og:image:width" content="1200" />
      <meta property="og:image:height" content="630" />
      <meta name="twitter:card" content="summary_large_image" />
      <meta name="twitter:title" content={TITLE} />
      <meta name="twitter:description" content={DESCRIPTION} />
      <meta name="twitter:image" content={OG_IMAGE} />
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    </BaseHead>
  </head>
  <body>
    <div class="glow"></div>
    <header class="nav">
      <a class="brand" href="/">
        <Logo />
        <span>layn</span>
      </a>
      <nav class="links">
        <a href={DOCS_URL}>Docs</a>
        <a href={PLAYGROUND_URL}>Playground</a>
        <a class="icon" href={REPO_URL} aria-label="GitHub">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"
            ><path
              d="M12 .5C5.7.5.5 5.7.5 12c0 5.1 3.3 9.4 7.9 10.9.6.1.8-.2.8-.6v-2c-3.2.7-3.9-1.5-3.9-1.5-.5-1.3-1.3-1.7-1.3-1.7-1.1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.7 1.3 3.4 1 .1-.8.4-1.3.7-1.6-2.6-.3-5.3-1.3-5.3-5.7 0-1.3.5-2.3 1.2-3.1-.1-.3-.5-1.5.1-3.1 0 0 1-.3 3.3 1.2a11.5 11.5 0 016 0C17.3 4.7 18.3 5 18.3 5c.6 1.6.2 2.8.1 3.1.8.8 1.2 1.8 1.2 3.1 0 4.4-2.7 5.4-5.3 5.7.4.4.8 1.1.8 2.2v3.3c0 .3.2.7.8.6 4.6-1.5 7.9-5.8 7.9-10.9C23.5 5.7 18.3.5 12 .5z"
            ></path></svg
          >
        </a>
      </nav>
    </header>

    <main>
      <div class="hero-copy">
        <h1>Compute your layout once. <span class="grad">Render it anywhere.</span></h1>
        <p class="lede">
          The headless layout engine. Deterministic on the server, virtualized on the client,
          rendered by any framework.
        </p>
        <div class="cta">
          <a class="btn primary" href={DOCS_URL}>Read the docs<span class="arr">&rarr;</span></a>
          <a class="btn ghost" href={PLAYGROUND_URL}>Playground</a>
        </div>
        <div class="algo-picker">
          <span class="algo-eyebrow">Layouts</span>
          <div class="algo-list">
            {
              algorithms.map((a, i) => (
                <button
                  type="button"
                  class={i === 0 ? 'algo-chip active' : 'algo-chip'}
                  data-algo={a.id}
                >
                  {a.name}
                </button>
              ))
            }
          </div>
        </div>
      </div>

      <div class="hero-art" aria-hidden="true">
        <div
          class="art-stage"
          id="art-stage"
          style={`width:${initSize.width}px;height:${initSize.height}px`}
        >
          {
            tiles.map((t, i) => (
              <span
                class={`art-tile tone-${t.tone}`}
                data-ar={t.ar}
                data-i={i}
                style={`transform:translate(${t.x}px, ${t.y}px);width:${t.w}px;height:${t.h}px`}
              />
            ))
          }
        </div>
      </div>
    </main>

    <script>
      import {
        binPacking,
        columns,
        createEngine,
        horizontalMasonry,
        justified,
        type LayoutAlgorithm,
        magazine,
        masonry,
        packing,
        quilt,
        staggered,
      } from '@laynjs/core'

      const COLS = 3

      const factories: Record<string, () => LayoutAlgorithm> = {
        masonry: () => masonry({ columns: COLS }),
        columns: () => columns({ columns: COLS }),
        justified: () => justified({ targetRowHeight: 128 }),
        staggered: () => staggered({ columns: COLS }),
        packing: () => packing({ baseSize: 122 }),
        binPacking: () => binPacking({ baseSize: 108 }),
        quilt: () => quilt({ columns: COLS }),
        magazine: () => magazine({ rowHeight: 128 }),
        horizontalMasonry: () => horizontalMasonry({ rows: COLS }),
      }

      const stage = document.getElementById('art-stage')
      const heroArt = document.querySelector<HTMLElement>('.hero-art')

      if (stage && heroArt) {
        const tileEls = Array.from(stage.querySelectorAll<HTMLElement>('.art-tile'))
        const items = tileEls.map((el, i) => ({ id: i, aspectRatio: Number(el.dataset.ar) }))
        const viewport = () => ({
          width: Math.round(heroArt.clientWidth) || 500,
          height: Math.round(heroArt.clientHeight) || 620,
        })

        const engine = createEngine({
          algorithm: factories.masonry(),
          items,
          gap: { x: 12, y: 12 },
          viewport: viewport(),
        })

        const apply = () => {
          const snapshot = engine.getSnapshot()
          for (let i = 0; i < tileEls.length; i += 1) {
            const el = tileEls[i]
            if (!el) continue
            const rect = snapshot.positions.rectAt(i)
            el.style.transform = `translate(${rect.x}px, ${rect.y}px)`
            el.style.width = `${rect.width}px`
            el.style.height = `${rect.height}px`
          }
          stage.style.width = `${snapshot.contentSize.width}px`
          stage.style.height = `${snapshot.contentSize.height}px`
        }

        const applyAxis = (id: string) => {
          heroArt.classList.toggle('horizontal', id === 'horizontalMasonry')
        }

        apply()
        window.setTimeout(() => stage.classList.add('ready'), 60)

        const chips = Array.from(document.querySelectorAll<HTMLButtonElement>('.algo-chip'))
        for (const chip of chips) {
          chip.addEventListener('click', () => {
            const id = chip.dataset.algo
            const make = id ? factories[id] : undefined
            if (!make || !id) return
            engine.setAlgorithm(make())
            applyAxis(id)
            apply()
            heroArt.scrollTop = 0
            heroArt.scrollLeft = 0
            for (const other of chips) {
              other.classList.toggle('active', other === chip)
            }
          })
        }

        let frame = 0
        window.addEventListener('resize', () => {
          cancelAnimationFrame(frame)
          frame = requestAnimationFrame(() => {
            engine.setViewport(viewport())
            apply()
          })
        })
      }
    </script>
  </body>
</html>
