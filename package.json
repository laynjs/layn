{
  "name": "layn-monorepo",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r --filter \"./packages/*\" run build",
    "clean": "pnpm -r run clean",
    "typecheck": "pnpm -r run typecheck && tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "bench": "pnpm build && node --expose-gc scripts/bench.mjs",
    "test:watch": "vitest",
    "check": "biome check . && prettier --check \"**/*.{astro,vue,svelte,html}\" && node scripts/check-loc.mjs",
    "check:fix": "biome check --write . && prettier --write \"**/*.{astro,vue,svelte,html}\"",
    "format": "prettier --write \"**/*.{astro,vue,svelte,html}\"",
    "test:e2e": "pnpm -r run e2e",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "pnpm build && pnpm publish -r --provenance --access public --no-git-checks && changeset tag"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@changesets/cli": "^2.31.1",
    "@playwright/test": "^1.49.0",
    "@types/node": "^22.0.0",
    "prettier": "^3.4.0",
    "prettier-plugin-astro": "^0.14.0",
    "prettier-plugin-svelte": "^4.1.1",
    "sharp": "^0.35.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
